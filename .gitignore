# ── Python Environments ───────────────────────────────────────────────────────
venv/
.venv/
.venv_test/
env/
ENV/

# ── Data Files (too large for git; restore by running pipeline) ───────────────
data/raw/
data/features/
data/processed/
data/*.db*
data/*.sqlite*
data/*.csv

# ── Generated Model Artifacts (restore by running training pipeline) ──────────
models/*.pkl
models/*.joblib
models/*.txt
models/*.model
!models/.gitkeep

# ── Generated Output Artifacts (restore by running production scoring) ─────────
outputs/*.csv
outputs/*.json
!outputs/.gitkeep

# ── Python Bytecode & Cache ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── IDE & OS Files ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Office Temporary Files ────────────────────────────────────────────────────
*.docx
~$*.docx
*.tmp

# ── Jupyter Notebooks Checkpoints ────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ── Docker ────────────────────────────────────────────────────────────────────
.dockerignore
